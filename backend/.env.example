# Server
PORT=3001
NODE_ENV=development

# Security - CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-too

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2a$10$YourHashedPasswordHere

# Database
DATABASE_URL=./data/projects.db

# CORS (comma-separated origins for production)
CORS_ORIGINS=https://mgreenhough.github.io

# Logging Configuration
# Days to keep logs before auto-deletion (default: 30)
LOG_RETENTION_DAYS=30
# Max log file size in MB before auto-trimming (default: 10)
LOG_MAX_SIZE_MB=10
# Cleanup interval in minutes (default: 60 = 1 hour)
LOG_CLEANUP_INTERVAL_MS=60
# Number of log entries to buffer before writing to disk (default: 100)
LOG_BUFFER_SIZE=100
# Interval in seconds to flush log buffer (default: 30)
LOG_FLUSH_INTERVAL_MS=30
